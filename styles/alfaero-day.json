{
  "version": 8,
  "name": "Alfaero Day",
  "metadata": {
    "alfaero:variant": "day",
    "alfaero:version": "0.1.0",
    "maputnik:renderer": "mlgljs"
  },
  "center": [-46.6, -23.5],
  "zoom": 4,
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://https://tiles.alfaero.com/planet-PLACEHOLDER.pmtiles",
      "attribution": "© <a href=\"https://openfreemap.org\">OpenFreeMap</a> © <a href=\"https://openmaptiles.org\">OpenMapTiles</a> © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
    }
  },
  "glyphs": "https://tiles.alfaero.com/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.alfaero.com/sprites/alfaero/alfaero",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f5f3ee" } },
    { "id": "landcover-glacier", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", "subclass", "glacier"], "paint": { "fill-color": "#fdfdfd", "fill-opacity": 0.7 } },
    { "id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", "class", "grass"], "paint": { "fill-color": "#e9efe1" } },
    { "id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", "class", "wood"], "paint": { "fill-color": "#dde6cf", "fill-opacity": 0.7 } },
    { "id": "landuse-park", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", "class", "park", "cemetery"], "paint": { "fill-color": "#e6efd3" } },
    { "id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", "class", "residential"], "paint": { "fill-color": "#eeece4" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "filter": ["!=", "intermittent", 1], "paint": { "fill-color": "#a8c8e0" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": { "line-color": "#a8c8e0", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 16, 2] } },
    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13,
      "paint": { "fill-color": "#e2ddd0", "fill-outline-color": "#cfc8b6" } },
    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 12,
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 18, 6] } },
    { "id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 8,
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": { "line-color": "#ffe2a8", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 18, 10] } },
    { "id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": { "line-color": "#ffc04d", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 18, 14] } },
    { "id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": { "line-color": "#FF6B35", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 18, 18] } },
    { "id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": { "line-color": "#999", "line-width": 1, "line-dasharray": [3, 2] } },
    { "id": "place-city", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["in", "class", "city", "town"], "minzoom": 4,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 14, 18]
      },
      "paint": { "text-color": "#333", "text-halo-color": "#fff", "text-halo-width": 1.5 }
    },
    { "id": "place-country", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["==", "class", "country"], "maxzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 10, 6, 20],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15
      },
      "paint": { "text-color": "#5a4a3a", "text-halo-color": "#f5f3ee", "text-halo-width": 1.5 }
    }
  ]
}
